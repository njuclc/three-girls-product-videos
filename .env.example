# --- Shopify Admin API (custom app token) ---
# Create at: Store admin -> Settings -> Apps and sales channels -> Develop apps
#   -> Create an app -> Configure Admin API scopes -> Install -> reveal Admin API access token
# Required scopes: read_products, write_products, read_files, write_files
SHOPIFY_STORE_DOMAIN=three-girls-develop.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-10

# --- App access password ---
# Anyone with this password can read/modify your store via this tool, so set a strong one.
# Leave empty ONLY for local development (the tool is then unprotected).
APP_PASSWORD=change-me
